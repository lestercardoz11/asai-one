# Copy to .env.local and fill in. Never commit real secrets.

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx     # secret, server-only — bypasses RLS
# Drizzle (admin/service) client — Supabase TRANSACTION pooler connection string
# (Dashboard → Project Settings → Database → Connection pooling → Transaction).
# Server-only, privileged role, bypasses RLS. Never NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ── Razorpay (Phase 4) ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── Resend (Phase 5) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=ASAI.One <support@asai.one>

# ── WhatsApp Business API (Phase 5) ──────────────────────────────────────────
WHATSAPP_PROVIDER=                    # e.g. meta | gupshup | twilio
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

CRON_SECRET=                          # authorizes the abandoned-cart cron route
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Used to build the password-reset / auth email redirect (→ /auth/confirm).
# Supabase dashboard → Authentication → URL Configuration: set the Site URL and
# add "<NEXT_PUBLIC_SITE_URL>/auth/confirm" to the Redirect URLs allowlist, or
# recovery links will be rejected.
